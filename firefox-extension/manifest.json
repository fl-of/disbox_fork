{
  "manifest_version": 2,
  "name": "Disbox Downloader for Firefox",
  "version": "0.1.1",
  "description": "Helps the Disbox web app download files from Discord by fetching attachment URLs from the extension context (bypassing page CORS restrictions).",
  "permissions": [
    "storage",
    "https://cdn.discordapp.com/*",
    "https://media.discordapp.net/*",
    "https://*.discordapp.com/*",
    "https://*.discordapp.net/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://disboxapp.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://localhost/*",
        "https://127.0.0.1/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "disbox-downloader@example.local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg"
  }
}
